# Copy this file to ".env" and fill in your own values.
# Do NOT commit the real .env — it contains secrets.

# ─── Database (MySQL) ───────────────────────────
# Format: mysql+pymysql://USER:PASSWORD@HOST/DB_NAME
DATABASE_URL=mysql+pymysql://root:YOUR_DB_PASSWORD@localhost/wood_factory

# ─── Flask session secret ───────────────────────
# Any long random string. If left unset, the app generates one automatically.
SECRET_KEY=change-me-to-a-long-random-string

# ─── Default admin account (created on first run) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=you@example.com

# ─── Password-reset emails (Resend — https://resend.com, 100 free/day) ──
# Create a free account, get an API key, paste it here.
RESEND_API_KEY=re_your_resend_api_key_here
# "From" address. onboarding@resend.dev works out of the box for testing.
RESEND_FROM=onboarding@resend.dev

# ─── Optional 3D tuning (safe defaults — usually leave as-is) ──
# HUNYUAN_MAX_FACES=40000
# HUNYUAN_TEXTURE_SIZE=1024
# HUNYUAN_SKIP_TEXTURE=0
# HOLO_WHITE_BG=1
